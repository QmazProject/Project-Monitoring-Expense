# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.
# Only VITE_* values are bundled into the browser. The anon key is safe there: Row Level Security and
# the checked SQL functions protect every table. NEVER put the service_role key in a VITE_ variable.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: company email domain, so people can sign in with just their username (the part before @).
VITE_USERNAME_DOMAIN=

# Show the "Try the demo" option on the sign-in page (true/false). Demo data lives only in the browser.
VITE_DEMO_ENABLED=true

# Later: Cloudflare Turnstile site key once captcha is enabled in Supabase (Auth → Attack protection).
VITE_TURNSTILE_SITE_KEY=

# ---- Server-side only (used by `npm run bootstrap:users`; never exposed to the browser) ----
# Supabase → Project Settings → API → service_role (secret). Keep this out of Vercel and out of git.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public half of the push notification key pair (npm run push:keys). Empty = notifications are not offered.
VITE_VAPID_PUBLIC_KEY=
